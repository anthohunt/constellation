# Copier en .env et remplir. Aucune valeur ci-dessous n'est réelle.

# --- Site (server/) ---
SITE_NAME=Constellation
# adresse publique du site, utilisée dans les liens des mails
BASE_PUBLIQUE=https://veille.example.org
PORT=8080
ADMIN_USER=admin
# console /admin (vide = console fermée)
ADMIN_PASS=change-me
SESSION_SECRET=change-me-long-random-string
# mur de connexion facultatif sur tout le site
AUTH_USER=admin
# "selHex:hashHex" (scrypt) ; vide = pas de mur
AUTH_HASH=

# Envoi des mails (codes de vérification, invitations). Facultatif pour un essai local.
MAIL_FROM=veille@example.org
MAIL_FROM_NAME=Constellation
REPLY_ADDR=verif@reply.example.org
# routeur d'emails (secours) ; vide = pas de secours
BREVO_API_KEY=
# clé DKIM de votre domaine, pour la remise directe (ex. /dkim/private.pem) ; vide = pas de remise directe
DKIM_KEY_FILE=
DKIM_SELECTOR=default
SMTP_HELO=mail.example.org
# adresse qui reçoit les signalements des lecteurs
REPORT_TO=

# Statistiques de visite, facultatif (sans clé, rien n'est injecté)
POSTHOG_KEY=
POSTHOG_HOST=https://eu.i.posthog.com

# Proposition d'axes au formulaire : Claude Code installé, sinon une de ces clés, sinon rien
AXES_BACKEND=on
CLAUDE_MODEL=claude-haiku-4-5
GROQ_API_KEY=
ANTHROPIC_API_KEY=

# Silo partagé avec la pipeline (le formulaire y pose les profils)
SILO=/silo
SILO_UID=1000
SILO_GID=1000

# --- Pipeline (pipeline/, skills/, viewer/) ---
# racine de ce dépôt
CONSTELLATION_HOME=/opt/constellation
# dossier data/ du site (monté dans son conteneur)
CONSTELLATION_DATA=/opt/constellation/data
CONSTELLATION_BASE_URL=https://veille.example.org
# même dossier que SILO côté hôte
VEILLE_OWNERS_DIR=/srv/veille-owners
VEILLE_SUBJECTS_DIR=/srv/veille-subjects
VEILLE_STATE_DIR=/srv/veille-state
# machine du site, si la pipeline tourne ailleurs (SSH)
VEILLE_SERVER=user@veille.example.org
# scripts facultatifs de mémoire de domaine (non fournis)
VEILLE_SCRIPTS=
# relais de transcription vidéo, facultatif
VEILLE_RELAIS=

# --- Moteur flux (voir son dépôt) ---
FLUX_HOME=/opt/flux
# les runs vivent sous $FLUX_RUNS_HOME/veille-runs
FLUX_RUNS_HOME=/srv
FLUX_SKILLS_DIR=/opt/constellation/skills
FLUX_WORKFLOWS_DIR=/opt/constellation/pipeline/workflows
FLUX_STATE_DIR=/opt/flux/state
